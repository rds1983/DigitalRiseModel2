#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)/Content
/intermediateDir:obj/$(Platform)/Content
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin Shaders/FullscreenColor.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:Shaders/FullscreenColor.fx

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=HAS_NORMAL;HAS_TANGENT
/build:Shaders/Pbr.fx;Shaders/Pbr.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=HAS_NORMAL
/build:Shaders/Pbr.fx;Shaders/PbrNoTangent.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:Shaders/Pbr.fx;Shaders/PbrBasic.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=SKINNED;HAS_NORMAL
/build:Shaders/Pbr.fx;Shaders/PbrSkinned.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=SKINNED
/build:Shaders/Pbr.fx;Shaders/PbrSkinnedBasic.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=HAS_NORMAL;HAS_TANGENT;HAS_COLOR
/build:Shaders/Pbr.fx;Shaders/PbrVertexColor.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=HAS_NORMAL;HAS_COLOR
/build:Shaders/Pbr.fx;Shaders/PbrNoTangentVertexColor.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=HAS_COLOR
/build:Shaders/Pbr.fx;Shaders/PbrBasicVertexColor.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=SKINNED;HAS_NORMAL;HAS_COLOR
/build:Shaders/Pbr.fx;Shaders/PbrSkinnedVertexColor.xnb

#begin Shaders/Pbr.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=SKINNED;HAS_COLOR
/build:Shaders/Pbr.fx;Shaders/PbrSkinnedBasicVertexColor.xnb

#begin Shaders/Pbr.fx
