<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DigitalRiseModel.Viewer</RootNamespace>
    <AssemblyName>DigitalRiseModel.Viewer</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>drm-viewer</ToolCommandName>
    <PackageId>DigitalRiseModel.Viewer</PackageId>
    <Description>MonoGame glTF viewer for the DigitalRiseModel library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalRiseModel\DigitalRiseModel.MonoGame.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
  </ItemGroup>

</Project>
