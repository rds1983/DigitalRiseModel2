<Project>
  <Project.ExportOptions Namespace="DigitalRiseModel.Viewer.UI" Class="ControlsPanel" OutputPath="DigitalRiseModel.Viewer/UI" FieldsVisibility="Private" />
  <VerticalStackPanel Spacing="4" Padding="8" Background="Black" Width="200">
    <Label Text="Controls" TextColor="White" />
    <Label Text="Left-drag: orbit" TextColor="White" />
    <Label Text="Mouse wheel: zoom" TextColor="White" />
    <Label Text="Escape: exit" TextColor="White" />
    <Label Text="F3: debug view" TextColor="White" />
  </VerticalStackPanel>
</Project>
